generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum CustomerSource {
  bot
  manual
  import
  api
}

// ── Core Business Models ─────────────────────────────────────

model Product {
  id               String                   @id @default(uuid())
  productCode      String                   @unique // Auto-generated: "ELC-AP-0001"
  itemNumber       String?                  @unique // Optional manual code
  name             String
  brandId          String?
  brandRef         Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  description      String?
  isAvailable      Boolean                  @default(false)
  alternativeNames Json?
  tags             Json?
  categoryId       String?
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  productImages    ProductImage[]
  variants         Variant[]
  productPrices    ProductPrice[]
  productUnits     ProductUnit[]
  orderItems       OrderItem[]
  notifications    AiNotification[]
  search_vector    Unsupported("tsvector")?

  @@unique([name, brandId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique // 2-letter code e.g. "SM" — used in item numbers
  logo        String? // URL path to uploaded logo image
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique // 3-char alphanumeric e.g. "ELC", "A12" — used in item numbers
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

// ── Customer (formerly Person) ───────────────────────────────

model Customer {
  id                   String                @id @default(uuid())
  name                 String?
  source               CustomerSource?
  contacts             Contact[]
  tags                 CustomerTag[]
  isActive             Boolean               @default(true)
  lastInteraction      DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  priceLabelId         String?
  priceLabel           PriceLabel?           @relation(fields: [priceLabelId], references: [id], onDelete: SetNull)
  customerCurrencies   CustomerCurrency[]
  orders               Order[]
  notifications        AiNotification[]
  announcementMessages AnnouncementMessage[]
  whatsappGroup        WhatsappGroup?        // علاقة عكسية — مجموعة واتساب اختيارية

  @@index([isActive])
  @@index([priceLabelId])
  @@map("Customer")
}

// Tags — normalized labels for customers
model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  customers CustomerTag[]
  createdAt DateTime      @default(now())
}

// Junction: Customer <-> Tag (many-to-many)
model CustomerTag {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([customerId, tagId])
}

// ── Supervisor (مشرف — بياناته فقط، لا يسجّل دخول) ──────────

model Supervisor {
  id             String                    @id @default(uuid())
  name           String
  notes          String?
  isActive       Boolean                   @default(true)
  contacts       Contact[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  whatsappGroups WhatsappGroupSupervisor[] // علاقة عكسية

  @@index([isActive])
  @@map("Supervisor")
}

// ── Contact (shared across Supervisor / Customer) ────────────

// Contact information (phone, email, whatsapp) — normalized
model Contact {
  id           String      @id @default(uuid())
  // Exactly ONE of the following must be set (enforced at app layer):
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supervisorId String?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  type      String // "phone" | "email" | "whatsapp"
  value     String // the actual number or email
  label     String? // "جوال", "عمل", etc.
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  // ── Uniqueness Constraints ──────────────────────────────────
  // 1) Global: same value (phone/email) cannot exist twice in the entire system
  @@unique([value], name: "contact_value_unique")
  // 2) Per-customer: only ONE contact of each type per customer
  //    (NULL customerId rows are treated as distinct by PostgreSQL)
  @@unique([customerId, type], name: "contact_customer_type_unique")
  // 3) Per-supervisor: only ONE contact of each type per supervisor
  @@unique([supervisorId, type], name: "contact_supervisor_type_unique")
}

// Junction table: Customer <-> Currency
model CustomerCurrency {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([customerId, currencyId])
}

// ── Product Images ───────────────────────────────────────────

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  filename  String
  alt       String?
  sizeBytes Int?
  width     Int?
  height    Int?

  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[] @relation("VariantToProductImages")

  @@unique([productId, url])
}

// ── Variants ────────────────────────────────────────────────

model Variant {
  id            String         @id @default(uuid())
  variantNumber String         @unique
  suffix        String
  name          String
  type          String         @default("color")
  hex           String?
  price         Decimal?       @db.Decimal(12, 2)
  order         Int            @default(0)
  isDefault     Boolean        @default(false)
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  variantImages ProductImage[] @relation("VariantToProductImages")
  orderItems    OrderItem[]

  @@unique([productId, suffix])
}

// ── Pricing ──────────────────────────────────────────────────

model PriceLabel {
  id            String         @id @default(uuid())
  itemNumber    String         @unique
  name          String         @unique
  customerType  String?        // نوع العميل المناسب: "عميل جملة"، "عميل مفرد"، "VIP"، إلخ
  notes         String?
  isDefault     Boolean        @default(false)
  customers     Customer[]
  productPrices ProductPrice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Currency {
  id                 String             @id @default(uuid())
  itemNumber         String             @unique
  name               String             @unique
  code               String             @unique
  symbol             String
  isDefault          Boolean            @default(false)
  exchangeRate       Decimal?           @db.Decimal(18, 6)
  productPrices      ProductPrice[]
  customerCurrencies CustomerCurrency[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ProductPrice {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLabelId     String
  priceLabel       PriceLabel @relation(fields: [priceLabelId], references: [id], onDelete: Cascade)
  currencyId       String
  currency         Currency   @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  unitId           String
  unit             Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  value            Decimal    @db.Decimal(12, 2)
  isAutoCalculated Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([productId, priceLabelId, currencyId, unitId])
}

model ProductUnit {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  isBase           Boolean @default(false)
  conversionFactor Int     @default(1)
  barcode          String? @unique
  order            Int     @default(0)

  @@unique([productId, unitId])
}

model Unit {
  id         String   @id @default(uuid())
  itemNumber String   @unique
  name       String   @unique
  pluralName String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productPrices ProductPrice[]
  productUnits  ProductUnit[]
}

// ── Orders ───────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status      String      @default("pending")
  notes       String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int       @default(1)
  notes     String?
  createdAt DateTime  @default(now())
}

// ── Notifications ────────────────────────────────────────────

model AiNotification {
  id            String    @id @default(uuid())
  type          String // "out_of_stock" | "not_found"
  searchQuery   String
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source        String?   @default("bot")
  phoneNumber   String?
  isRead        Boolean   @default(false)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archiveReason String?
  createdAt     DateTime  @default(now())

  @@index([isRead])
  @@index([isArchived])
  @@index([type])
  @@index([createdAt])
  @@index([customerId])
}

// ── User Accounts (dashboard login) ─────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  username  String    @unique
  password  String // bcrypt hashed
  color     String    @default("#6366f1") // avatar color
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── Store Settings ───────────────────────────────────────────

model StoreSettings {
  id           String   @id @default("default")
  name         String   @default("المتجر الرئيسي")
  description  String?
  logo         String?
  favicon      String?
  phone        String?
  email        String?
  whatsapp     String?
  website      String?
  address      String?
  city         String?
  country      String?
  workingHours Json?
  socialLinks  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Announcements ────────────────────────────────────────────

model MessageTemplate {
  id            String         @id @default(uuid())
  name          String
  type          String         @default("text")
  sendMode      String         @default("combined")
  bodyTemplate  String         @db.Text
  productBlock  String         @db.Text
  separator     String         @default("\n---\n")
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]

  @@index([isDefault])
}

model Announcement {
  id                  String                @id @default(uuid())
  title               String
  description         String?
  status              String                @default("pending")
  scheduledAt         DateTime
  sentAt              DateTime?
  personFilters       Json
  productFilters      Json
  templateId          String?
  template            MessageTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  delayBetweenSeconds Int                   @default(0)
  sendWindowStart     String?
  sendWindowEnd       String?
  queueingProgress    Int                   @default(0)
  createdBy           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  messages            AnnouncementMessage[]
}

model AnnouncementMessage {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  messageIndex   Int
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName   String?
  whatsappNumber String?
  productIds     Json         @default("[]")
  messageBody    String       @db.Text
  imageUrls      Json         @default("[]")
  status         String       @default("pending")
  providerId     String?
  errorReason    String?
  retryCount     Int          @default(0)
  queuedAt       DateTime     @default(now())
  sentAt         DateTime?

  @@unique([announcementId, customerId])
  @@index([announcementId])
  @@index([announcementId, status])
  @@index([customerId])
  @@index([announcementId, messageIndex])
  @@index([status])
}

// ── Product Code Sequences ───────────────────────────────────

model ProductCodeSequence {
  id           String   @id @default(uuid())
  categoryCode String
  brandCode    String
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryCode, brandCode])
}

// ── WhatsApp Groups ───────────────────────────────────────────────────

// مجموعة واتساب — تربط عميلاً واحداً بمشرفين عدة
model WhatsappGroup {
  id          String   @id @default(uuid())
  code        String   @unique // كود مكون من 3 حروف/أرقام
  groupNumber String?  @unique // معرّف المجموعة على واتساب: "120363...@g.us"
  name        String // اسم وصفي للمجموعة
  notes       String? // ملاحظات داخلية
  isActive    Boolean  @default(true)

  // علاقة 1-to-1 مع العميل — عميل واحد فقط لكل مجموعة
  customerId  String   @unique
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // علاقة many-to-many مع المشرفين
  supervisors WhatsappGroupSupervisor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("WhatsappGroup")
}

// جدول وسيط بسيط — بدون حقول إضافية
model WhatsappGroupSupervisor {
  groupId      String
  group        WhatsappGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   Supervisor    @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@id([groupId, supervisorId])
  @@map("WhatsappGroupSupervisor")
}
