generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum PersonSource {
  bot
  manual
  import
  api
}

model Product {
  id               String                   @id @default(uuid())
  productCode      String                   @unique    // Auto-generated: "ELC-AP-0001"
  itemNumber       String?                  @unique    // Optional manual code
  name             String
  brandId          String?
  brandRef         Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  description      String?
  isAvailable      Boolean                  @default(true)
  alternativeNames Json?
  tags             Json?
  categoryId       String?
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  productImages    ProductImage[]
  variants         Variant[]
  productPrices    ProductPrice[]
  productUnits     ProductUnit[]
  orderItems       OrderItem[]
  notifications    AiNotification[]
  search_vector    Unsupported("tsvector")?
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique // 2-letter code e.g. "SM" — used in item numbers
  logo        String?   // URL path to uploaded logo image
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique // 3-char alphanumeric e.g. "ELC", "A12" — used in item numbers
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Person {
  id                   String                @id @default(uuid())
  name                 String?
  personTypeId         String?
  personType           PersonType?           @relation(fields: [personTypeId], references: [id], onDelete: SetNull)
  source               PersonSource?
  contacts             Contact[]
  tags                 PersonTag[]
  groupName            String?
  groupNumber          String?               @unique
  isActive             Boolean               @default(true)
  lastInteraction      DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  priceLabels          PersonPriceLabel[]
  personCurrencies     PersonCurrency[]
  orders               Order[]
  notifications        AiNotification[]
  announcementMessages AnnouncementMessage[]

  @@index([personTypeId])
  @@index([groupName])
  @@index([isActive])
  @@map("Person")
}

// Tags — normalized labels for persons
model Tag {
  id      String      @id @default(uuid())
  name    String      @unique
  persons PersonTag[]

  createdAt DateTime @default(now())
}

// Junction: Person <-> Tag (many-to-many)
model PersonTag {
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([personId, tagId])
}

// Product images — image metadata stored directly (no separate MediaImage table)
model ProductImage {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  // ── Image metadata (previously in MediaImage) ──
  url       String    // Sub-path only, e.g. "products/001-bf-607/main.webp" — base path is in .env
  filename  String
  alt       String?
  sizeBytes Int?
  width     Int?
  height    Int?

  // ── Linking metadata ──
  isPrimary Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ── Variant association ──
  variants  Variant[] @relation("VariantToProductImages")

  @@unique([productId, url])
}

// Variants table: colors, sizes, custom variants
model Variant {
  id            String         @id @default(uuid())
  variantNumber String         @unique // "001-BF-483-01" — globally unique
  suffix        String // "01", "أسود", "XL" — user-entered 4th segment
  name          String // display name
  type          String         @default("color") // "color" | "size" | "custom"
  hex           String? // CSS hex color (for type=color only)
  price         Decimal?       @db.Decimal(12, 2) // Variant-specific price override
  order         Int            @default(0)
  isDefault     Boolean        @default(false)
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  variantImages ProductImage[] @relation("VariantToProductImages")
  orderItems    OrderItem[]

  @@unique([productId, suffix])
}

// Price label names for product pricing
model PriceLabel {
  id            String             @id @default(uuid())
  itemNumber    String             @unique
  name          String             @unique
  notes         String?
  persons       PersonPriceLabel[]
  productPrices ProductPrice[]
  orderItems    OrderItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// Explicit join table for Person <-> PriceLabel
model PersonPriceLabel {
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId     String
  priceLabel   PriceLabel @relation(fields: [priceLabelId], references: [id], onDelete: Cascade)
  priceLabelId String

  assignedAt DateTime @default(now())

  @@id([personId, priceLabelId])
}

// Person type classifications
model PersonType {
  id        String   @id @default(uuid())
  name      String   @unique
  persons   Person[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact information (phone, email, whatsapp) — normalized
model Contact {
  id        String   @id @default(uuid())
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "phone" | "email" | "whatsapp"
  value     String // the actual number or email
  label     String? // "جوال", "عمل", etc.
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  // Per-owner uniqueness — same number allowed for different persons/users
  @@unique([personId, type, value], name: "person_contact_unique")
  @@unique([userId, type, value], name: "user_contact_unique")
}

// Junction table: Person <-> Currency (replaces currencies Json field)
model PersonCurrency {
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([personId, currencyId])
}

// Currency management
model Currency {
  id               String           @id @default(uuid())
  itemNumber       String           @unique
  name             String           @unique // e.g. "ريال يمني"
  code             String           @unique // e.g. "YER"
  symbol           String // e.g. "ر.ي"
  isDefault        Boolean          @default(false)
  isActive         Boolean          @default(true)
  exchangeRate     Decimal?         @db.Decimal(18, 6) // rate relative to default currency (null for default)
  productPrices    ProductPrice[]
  orderItems       OrderItem[]
  personCurrencies PersonCurrency[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// Product prices — normalized pricing with multi-currency support
model ProductPrice {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLabelId     String
  priceLabel       PriceLabel @relation(fields: [priceLabelId], references: [id], onDelete: Cascade)
  currencyId       String
  currency         Currency   @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  unitId           String
  unit             Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  value            Decimal    @db.Decimal(12, 2)
  isAutoCalculated Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([productId, priceLabelId, currencyId, unitId])
}

// Links available units to a product
model ProductUnit {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  isBase           Boolean @default(false)
  conversionFactor Int     @default(1) // how many base units in this specific product's unit (e.g. this product's carton has 24 pieces)
  barcode          String? @unique // barcode specifically for this product's unit size
  order            Int     @default(0)

  @@unique([productId, unitId])
}

// Unit model for pricing units (e.g., Piece, Dozen, Box)
model Unit {
  id         String   @id @default(uuid())
  itemNumber String   @unique
  name       String   @unique
  pluralName String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productPrices ProductPrice[]
  productUnits  ProductUnit[]
}

// Represents a customer order
model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // auto-generated e.g. "0001"
  personId    String?
  person      Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  status      String      @default("pending")
  // "pending" | "confirmed" | "processing" | "shipped" | "delivered" | "cancelled"
  notes       String?
  totalAmount Decimal?    @db.Decimal(12, 2) // pre-computed sum from items
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Individual line items inside an order
model OrderItem {
  id           String      @id @default(uuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      Variant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  priceLabelId String?
  priceLabel   PriceLabel? @relation(fields: [priceLabelId], references: [id], onDelete: SetNull)
  // Snapshot of price & currency from ProductPrice at order creation time
  unitPrice    Decimal     @db.Decimal(12, 2)
  currencyId   String?
  currency     Currency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  quantity     Int         @default(1)
  notes        String?
  createdAt    DateTime    @default(now())
}

// AI-driven notifications from bot product searches
model AiNotification {
  id            String    @id @default(uuid())
  type          String // "out_of_stock" | "not_found"
  searchQuery   String
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String?
  personId      String?
  person        Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  source        String?   @default("bot") // "bot" | "api"
  phoneNumber   String?
  isRead        Boolean   @default(false)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archiveReason String?
  createdAt     DateTime  @default(now())

  @@index([isRead])
  @@index([isArchived])
  @@index([type])
  @@index([createdAt])
  @@index([personId])
}

// User accounts for dashboard authentication
model User {
  id        String    @id @default(uuid())
  name      String
  username  String    @unique
  password  String // bcrypt hashed
  role      String    @default("user") // "admin" | "user"
  color     String    @default("#6366f1") // avatar color
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
}

// Store settings — singleton row (id = "default")
model StoreSettings {
  id           String   @id @default("default")
  name         String   @default("المتجر الرئيسي")
  description  String?
  logo         String? // URL path to uploaded logo image
  favicon      String? // URL path to uploaded favicon
  phone        String?
  email        String?
  whatsapp     String?
  website      String?
  address      String?
  city         String?
  country      String?
  workingHours Json? // { "sun": "8:00-17:00", ... }
  socialLinks  Json? // { "facebook": "...", "instagram": "...", ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Message templates for announcement campaigns
model MessageTemplate {
  id            String         @id @default(uuid())
  name          String
  type          String         @default("text") // "text" | "text_image"
  sendMode      String         @default("combined") // "combined" | "per_product"
  bodyTemplate  String         @db.Text
  productBlock  String         @db.Text
  separator     String         @default("\n---\n")
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]

  @@index([isDefault])
}

// Announcements system for mass messaging
model Announcement {
  id                  String                @id @default(uuid())
  title               String
  description         String?
  status              String                @default("pending") // pending | queueing | queued | sent | failed | cancelled
  scheduledAt         DateTime
  sentAt              DateTime?
  // ── Targeting (JSON filters — single source) ──
  personFilters       Json // { all: true } | { manualIds: [...] } | { typeIds: [...], tags: [...] }
  productFilters      Json // { all: true } | { manualIds: [...] } | { categoryIds: [...] }
  // ── Template ──
  templateId          String?
  template            MessageTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // ── Throttle / Rate Limit ──
  delayBetweenSeconds Int                   @default(0)
  sendWindowStart     String? // "09:00"
  sendWindowEnd       String? // "18:00"
  // ── Queueing progress (0-100) ──
  queueingProgress    Int                   @default(0)
  // ── Metadata ──
  createdBy           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  // ── Relations ──
  messages            AnnouncementMessage[]
}

// Per-person delivery record — THE source of truth for tracking
model AnnouncementMessage {
  id             String       @id @default(uuid())
  // ── Campaign ──
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  messageIndex   Int // 1-based order
  // ── Person (FK required) ──
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  personName     String?
  whatsappNumber String?
  // ── Products (JSON array of IDs) ──
  productIds     Json         @default("[]")
  // ── Content ──
  messageBody    String       @db.Text
  imageUrls      Json         @default("[]")
  // ── Delivery ──
  status         String       @default("pending") // pending | sent | failed
  providerId     String? // WhatsApp message ID
  errorReason    String?
  retryCount     Int          @default(0)
  // ── Timestamps ──
  queuedAt       DateTime     @default(now())
  sentAt         DateTime?

  @@unique([announcementId, personId])
  @@index([announcementId])
  @@index([announcementId, status])
  @@index([personId])
  @@index([announcementId, messageIndex])
  @@index([status])
}

/// Tracks the last used sequence number per category+brand combo.
/// Ensures product code numbers are never reused even after deletion.
model ProductCodeSequence {
  id             String   @id @default(uuid())
  categoryCode   String   // e.g. "ELC" or "GEN"
  brandCode      String   // e.g. "AP" or "XX"
  lastSequence   Int      @default(0)  // Last used number (0001, 0002, ...)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([categoryCode, brandCode])
}
