{
  "name": "nawaat-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "================ التطوير (DEVELOPMENT) ================": "",
    "up": "docker compose -f docker-compose.dev.yml up -d",
    "down": "docker compose -f docker-compose.dev.yml down",
    "rebuild": "docker compose -f docker-compose.dev.yml up -d --build",
    "logs": "docker compose -f docker-compose.dev.yml logs -f",
    "logs:app": "docker logs -f nawaat_nextjs_dev",
    "shell": "docker exec -it nawaat_nextjs_dev sh",
    "reset:dev": "docker compose -f docker-compose.dev.yml down -v && npm run up",
    "================ قاعدة البيانات (PRISMA DEV) ================": "",
    "db:migrate": "docker exec -it nawaat_nextjs_dev npx prisma migrate dev",
    "db:generate": "docker exec nawaat_nextjs_dev npx prisma generate",
    "db:seed": "docker exec -it nawaat_nextjs_dev npx prisma db seed",
    "db:push": "docker exec -it nawaat_nextjs_dev npx prisma db push",
    "================ الإنتاج (PRODUCTION) ================": "",
    "prod:deploy": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f --tail=100",
    "prod:shell": "docker exec -it nawaat_nextjs sh",
    "prod:migrate": "docker exec -it nawaat_nextjs npx prisma migrate deploy",
    "================= الاختبار (TESTING) ================": "",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.2",
    "lucide-react": "^0.563.0",
    "meilisearch": "^0.58.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.4.0",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sharp": "^0.34.3",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.32.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.35",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
