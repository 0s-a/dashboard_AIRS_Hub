{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-env-commit.sh",
        "matcher": "git\\s+commit",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/require-bugbot-before-pr.sh",
        "matcher": "gh\\s+pr\\s+create",
        "failClosed": false
      }
    ]
  }
}
