generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum CustomerSource {
  bot
  manual
  import
  api
}

enum PersonType {
  customer
  supervisor
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

// ── Core Business Models ─────────────────────────────────────

model ProductFamily {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([categoryId])
}

model Product {
  id                String                   @id @default(uuid())
  itemNumber        String                   @unique // رقم الصنف — إلزامي وفريد
  name              String
  slug              String                   @unique
  brandId           String
  brandRef          Brand                    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  description       String?
  alternativeNames  Json?
  tags              Json?
  familyId          String
  family            ProductFamily            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  isAvailable       Boolean                  @default(true)
  order             Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  productPrices     ProductPrice[]
  productImages     ProductImage[]
  productUnits      ProductUnit[]
  productAttributes ProductAttributeValue[]
  orderItems        OrderItem[]
  notifications     AiNotification[]
  search_vector     Unsupported("tsvector")?

  @@index([familyId])
}

model ProductAttribute {
  id        String                  @id @default(uuid())
  code      String                  @unique
  name      String                  @unique
  examples  Json? // string[] — اقتراحات سريعة للواجهة فقط
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  values    ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String           @id @default(uuid())
  productId   String
  attributeId String
  value       String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId])
  @@index([attributeId, value])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  logo        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Category {
  id          String          @id @default(uuid())
  name        String          @unique
  code        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  families    ProductFamily[]
}

// ── Customer (formerly Person) ───────────────────────────────

model Customer {
  id                   String                @id @default(uuid())
  name                 String?
  type                 PersonType            @default(customer)
  notes                String?
  source               CustomerSource?
  contacts             Contact[]
  tags                 CustomerTag[]
  isActive             Boolean               @default(true)
  lastInteraction      DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  priceLabelId         String?
  priceLabel           PriceLabel?           @relation(fields: [priceLabelId], references: [id], onDelete: SetNull)
  customerCurrencies   CustomerCurrency[]
  orders        Order[]
  notifications AiNotification[]

  @@index([isActive])
  @@index([type])
  @@index([priceLabelId])
  @@map("Customer")
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  customers CustomerTag[]
  createdAt DateTime      @default(now())
}

model CustomerTag {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([customerId, tagId])
}

model Contact {
  id           String      @id @default(uuid())
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type      String
  value     String
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([value], name: "contact_value_unique")
  @@unique([customerId, type], name: "contact_customer_type_unique")
}

model CustomerCurrency {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([customerId, currencyId])
}

// ── Product Images ───────────────────────────────────────────

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  filename  String
  alt       String?
  sizeBytes Int?
  width     Int?
  height    Int?

  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, url])
  @@index([productId])
}

// ── Pricing ──────────────────────────────────────────────────

model PriceLabel {
  id            String         @id @default(uuid())
  itemNumber    String         @unique
  name          String         @unique
  customerType  String?
  notes         String?
  isDefault     Boolean        @default(false)
  customers     Customer[]
  productPrices ProductPrice[]
  orderItems    OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Currency {
  id                 String             @id @default(uuid())
  itemNumber         String             @unique
  name               String             @unique
  code               String             @unique
  symbol             String
  isDefault          Boolean            @default(false)
  exchangeRate       Decimal?           @db.Decimal(18, 6)
  customerCurrencies CustomerCurrency[]
  orderItems         OrderItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ProductPrice {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLabelId     String
  priceLabel       PriceLabel @relation(fields: [priceLabelId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  value            Decimal    @db.Decimal(12, 2)
  isAutoCalculated Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([productId, priceLabelId, unitId])
}

model ProductUnit {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  isBase           Boolean @default(false)
  conversionFactor Int     @default(1)
  barcode          String? @unique
  order            Int     @default(0)

  @@unique([productId, unitId])
}

model Unit {
  id         String   @id @default(uuid())
  itemNumber String   @unique
  name       String   @unique
  pluralName String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productPrices ProductPrice[]
  productUnits  ProductUnit[]
  orderItems    OrderItem[]
}

// ── Orders ───────────────────────────────────────────────────

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status       OrderStatus @default(pending)
  notes        String?
  deliveryInfo String?
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId    String?
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quantity  Int       @default(1)
  notes     String?

  unitPrice    Decimal?    @db.Decimal(12, 2)
  currencyId   String?
  currency     Currency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  priceLabelId String?
  priceLabel   PriceLabel? @relation(fields: [priceLabelId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([unitId])
}

// ── Notifications ────────────────────────────────────────────

model AiNotification {
  id            String    @id @default(uuid())
  type          String
  searchQuery   String
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source        String?   @default("bot")
  phoneNumber   String?
  isRead        Boolean   @default(false)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archiveReason String?
  createdAt     DateTime  @default(now())

  @@index([isRead])
  @@index([isArchived])
  @@index([type])
  @@index([createdAt])
  @@index([customerId])
}

// ── User Accounts (dashboard login) ─────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  username  String    @unique
  password  String
  color     String    @default("#6366f1")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── Store Settings ───────────────────────────────────────────

model StoreSettings {
  id           String   @id @default("default")
  name         String   @default("المتجر الرئيسي")
  description  String?
  logo         String?
  favicon      String?
  phone        String?
  email        String?
  whatsapp     String?
  website      String?
  address      String?
  city         String?
  country      String?
  workingHours Json?
  socialLinks  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
