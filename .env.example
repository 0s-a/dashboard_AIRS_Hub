# Environment variables for Nawaat CRM (copy to .env.development or .env.production)
# Never commit real values — this file is safe to commit.

# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Bot API
BOT_API_KEY=
# Optional: POST JSON on order status change (fire-and-forget)
BOT_ORDER_WEBHOOK_URL=
# Optional Bearer token sent as Authorization header
BOT_ORDER_WEBHOOK_SECRET=

# Meilisearch
MEILISEARCH_HOST=
MEILISEARCH_MASTER_KEY=
MEILISEARCH_INDEX=

# RabbitMQ
RABBITMQ_URL=
RABBITMQ_QUEUE_NAME=

# App
NEXT_PUBLIC_BASE_URL=

# Image storage
IMAGE_STORAGE_PATH=
IMAGE_DISK_ROOT=
