generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum CustomerSource {
  bot
  manual
  import
  api
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum SkuSpecKind {
  size
  packaging
  length
  free
}

// ── Core Business Models ─────────────────────────────────────

model Product {
  id               String                   @id @default(uuid())
  productNumber    String                   @unique // User-entered 3-char code e.g. "001"
  name             String
  slug             String                   @unique
  skuSpecKind      SkuSpecKind              @default(free)
  brandId          String?
  brandRef         Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  description      String?
  alternativeNames Json?
  tags             Json?
  categoryId       String?
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  skcs             SKC[]
  productUnits     ProductUnit[]
  orderItems       OrderItem[]
  notifications    AiNotification[]
  search_vector    Unsupported("tsvector")?

  @@unique([name, brandId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique // 1-char alphanumeric e.g. "S" — used in product numbers
  logo        String? // URL path to uploaded logo image
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique // 2-char alphanumeric e.g. "EL", "A1" — used in item numbers
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  description String?
  icon        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
}

model ProductAttribute {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ProductAttribute")
}

model Color {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  hexCode   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skcs      SKC[]

  @@map("Color")
}

// ── Customer (formerly Person) ───────────────────────────────

model Customer {
  id                   String                @id @default(uuid())
  name                 String?
  source               CustomerSource?
  contacts             Contact[]
  tags                 CustomerTag[]
  isActive             Boolean               @default(true)
  lastInteraction      DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  priceLabelId         String?
  priceLabel           PriceLabel?           @relation(fields: [priceLabelId], references: [id], onDelete: SetNull)
  customerCurrencies   CustomerCurrency[]
  orders        Order[]
  notifications AiNotification[]

  @@index([isActive])
  @@index([priceLabelId])
  @@map("Customer")
}

// Tags — normalized labels for customers
model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  customers CustomerTag[]
  createdAt DateTime      @default(now())
}

// Junction: Customer <-> Tag (many-to-many)
model CustomerTag {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([customerId, tagId])
}

// ── Supervisor (مشرف — بياناته فقط، لا يسجّل دخول) ──────────

model Supervisor {
  id             String                    @id @default(uuid())
  name           String
  notes          String?
  isActive       Boolean                   @default(true)
  contacts  Contact[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("Supervisor")
}

// ── Contact (shared across Supervisor / Customer) ────────────

// Contact information (phone, email, whatsapp) — normalized
model Contact {
  id           String      @id @default(uuid())
  // Exactly ONE of the following must be set (enforced at app layer):
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supervisorId String?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  type      String // "phone" | "email" | "whatsapp"
  value     String // the actual number or email
  label     String? // "جوال", "عمل", etc.
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  // ── Uniqueness Constraints ──────────────────────────────────
  // 1) Global: same value (phone/email) cannot exist twice in the entire system
  @@unique([value], name: "contact_value_unique")
  // 2) Per-customer: only ONE contact of each type per customer
  //    (NULL customerId rows are treated as distinct by PostgreSQL)
  @@unique([customerId, type], name: "contact_customer_type_unique")
  // 3) Per-supervisor: only ONE contact of each type per supervisor
  @@unique([supervisorId, type], name: "contact_supervisor_type_unique")
}

// Junction table: Customer <-> Currency
model CustomerCurrency {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([customerId, currencyId])
}

// ── Product Images ───────────────────────────────────────────

model ProductImage {
  id      String @id @default(uuid())
  skcId   String
  skc     SKC    @relation(fields: [skcId], references: [id], onDelete: Cascade)

  url       String
  filename  String
  alt       String?
  sizeBytes Int?
  width     Int?
  height    Int?

  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skcId, url])
  @@index([skcId])
}

// ── SKC / SKU (SPU inventory hierarchy) ─────────────────────

model SKC {
  id          String         @id @default(uuid())
  itemNumber  String?        @unique // Optional manual item code (barcode)
  attributes  Json?          @db.JsonB // { [ProductAttribute.code]: string }
  colorId     String
  color       Color          @relation(fields: [colorId], references: [id], onDelete: Restrict)
  isDefault   Boolean        @default(false)
  order       Int            @default(0)
  isAvailable Boolean        @default(true)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  skus        SKU[]
  images      ProductImage[]

  @@unique([productId, colorId])
}

model SKU {
  id            String         @id @default(uuid())
  skuCode       String         @unique
  sizeLabel     String?
  isAvailable   Boolean        @default(true)
  isDefault     Boolean        @default(false)
  order         Int            @default(0)
  skcId         String
  skc           SKC            @relation(fields: [skcId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  productPrices ProductPrice[]
  orderItems    OrderItem[]

  @@unique([skcId, sizeLabel])
}

// ── Pricing ──────────────────────────────────────────────────

model PriceLabel {
  id            String         @id @default(uuid())
  itemNumber    String         @unique
  name          String         @unique
  customerType  String?        // نوع العميل المناسب: "عميل جملة"، "عميل مفرد"، "VIP"، إلخ
  notes         String?
  isDefault     Boolean        @default(false)
  customers     Customer[]
  productPrices ProductPrice[]
  orderItems    OrderItem[]    // علاقة عكسية — snapshot
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Currency {
  id                 String             @id @default(uuid())
  itemNumber         String             @unique
  name               String             @unique
  code               String             @unique
  symbol             String
  isDefault          Boolean            @default(false)
  exchangeRate       Decimal?           @db.Decimal(18, 6)
  productPrices      ProductPrice[]
  customerCurrencies CustomerCurrency[]
  orderItems         OrderItem[]        // علاقة عكسية — snapshot
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ProductPrice {
  id               String     @id @default(uuid())
  skuId            String
  sku              SKU        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  priceLabelId     String
  priceLabel       PriceLabel @relation(fields: [priceLabelId], references: [id], onDelete: Cascade)
  currencyId       String
  currency         Currency   @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  unitId           String
  unit             Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  value            Decimal    @db.Decimal(12, 2)
  isAutoCalculated Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([skuId, priceLabelId, currencyId, unitId])
}

model ProductUnit {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  isBase           Boolean @default(false)
  conversionFactor Int     @default(1)
  barcode          String? @unique
  order            Int     @default(0)

  @@unique([productId, unitId])
}

model Unit {
  id         String   @id @default(uuid())
  itemNumber String   @unique
  name       String   @unique
  pluralName String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productPrices ProductPrice[]
  productUnits  ProductUnit[]
  orderItems    OrderItem[]
}

// ── Orders ───────────────────────────────────────────────────

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status       OrderStatus @default(pending)
  notes        String?
  deliveryInfo String?     // معلومات التوصيل — نص حر (عنوان، كوريير، ملاحظات)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  skuId     String?
  sku       SKU?      @relation(fields: [skuId], references: [id], onDelete: SetNull)
  unitId    String?
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quantity  Int       @default(1)
  notes     String?

  // Snapshot — السعر المُثبَّت وقت إنشاء الطلب (لا يتأثر بتغيير الأسعار لاحقاً)
  unitPrice    Decimal?    @db.Decimal(12, 2)
  currencyId   String?
  currency     Currency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  priceLabelId String?
  priceLabel   PriceLabel? @relation(fields: [priceLabelId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())

  @@index([orderId])
  @@index([unitId])
}

// ── Notifications ────────────────────────────────────────────

model AiNotification {
  id            String    @id @default(uuid())
  type          String // "out_of_stock" | "not_found"
  searchQuery   String
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source        String?   @default("bot")
  phoneNumber   String?
  isRead        Boolean   @default(false)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archiveReason String?
  createdAt     DateTime  @default(now())

  @@index([isRead])
  @@index([isArchived])
  @@index([type])
  @@index([createdAt])
  @@index([customerId])
}

// ── User Accounts (dashboard login) ─────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  username  String    @unique
  password  String // bcrypt hashed
  color     String    @default("#6366f1") // avatar color
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── Store Settings ───────────────────────────────────────────

model StoreSettings {
  id           String   @id @default("default")
  name         String   @default("المتجر الرئيسي")
  description  String?
  logo         String?
  favicon      String?
  phone        String?
  email        String?
  whatsapp     String?
  website      String?
  address      String?
  city         String?
  country      String?
  workingHours Json?
  socialLinks  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}